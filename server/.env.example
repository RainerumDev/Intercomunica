# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://intercomunica:intercomunica@localhost:5432/intercomunica"

# --- Server -------------------------------------------------------------------
PORT=3000
BASE_URL="http://localhost:3000"
WEB_URL="http://localhost:5173"

# --- Google Cloud OAuth client (type: Web application) ------------------------
# Authorized redirect URIs to register:
#   {BASE_URL}/api/auth/google/callback
#   {BASE_URL}/api/admin/master/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Security -----------------------------------------------------------------
# JWT_SECRET: any long random string (>=16 chars)
JWT_SECRET=""
# ENCRYPTION_KEY: 64 hex chars (32 bytes). Generate: openssl rand -hex 32
ENCRYPTION_KEY=""

# Comma-separated emails granted ADMIN role (presidenza, vicepresidi, tecnici, direttore)
ADMIN_EMAILS="presidenza@rainerum.it"

# Static token protecting the digital-signage RSS feed (WIP B)
SIGNAGE_TOKEN=""
