+++ b/e2e/public-timetable.spec.ts
@@ -255,6 +255,11 @@ test("school mobile grid fits the page and supports two-finger vertical scaling"
   await page.goto(`/orario/${publicationFixture.weekStart}?giorno=2026-10-12&scuola=media`);
   const grid = page.getByRole("region", { name: "Orario giornaliero della scuola Media" });
   await expect(grid).toHaveAttribute("data-scale-mode", "fit");
+  await expect.poll(() => grid.evaluate((element) => {
+    const header = element.querySelector<HTMLElement>(".school-day-grid__headers")!;
+    const body = element.querySelector<HTMLElement>(".school-day-grid__classes")!;
+    return Math.abs(body.getBoundingClientRect().height - (element.clientHeight - header.getBoundingClientRect().height));
+  })).toBeLessThanOrEqual(2);
 
   const fitted = await grid.evaluate((element) => {
     const table = element.querySelector<HTMLElement>(".school-day-grid__table")!;
@@ -311,9 +316,9 @@ test("heading and selected controls keep readable foreground colors", async ({ p
     selectedMode: getComputedStyle(document.querySelector(".desktop-mode-navigation [aria-current='page']")!).color,
   }));
   expect(colors).toEqual({
-    heading: "rgb(23, 25, 29)",
-    pdf: "rgb(45, 54, 67)",
-    selectedMode: "rgb(7, 83, 166)",
+    heading: "rgb(38, 24, 22)",
+    pdf: "rgb(38, 24, 22)",
+    selectedMode: "rgb(184, 24, 27)",
   });
 });
 
